{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|mcp__.*|SendMessage|CronCreate|CronDelete|RemoteTrigger|PushNotification|ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
